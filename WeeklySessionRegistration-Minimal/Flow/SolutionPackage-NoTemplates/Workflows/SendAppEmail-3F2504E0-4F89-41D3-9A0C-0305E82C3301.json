{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "impersonation": {},
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "wsr_sharedoffice365"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_teams": {
        "impersonation": {},
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "wsr_sharedteams"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "To",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Recipient email address",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "Subject",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Email subject",
                  "x-ms-content-hint": "TEXT"
                },
                "text_2": {
                  "title": "Body",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Email body (plain text)",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text",
                "text_1",
                "text_2"
              ]
            }
          }
        }
      },
      "actions": {
        "Send_an_email_(V2)": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
            },
            "parameters": {
              "emailMessage/To": "@triggerBody()?['text']",
              "emailMessage/Subject": "@triggerBody()?['text_1']",
              "emailMessage/Body": "<div style='margin:0;padding:24px;background-color:#F6F7FB;font-family:Segoe UI,Arial,sans-serif;'><div style='max-width:600px;margin:0 auto;background-color:#FFFFFF;border:1px solid #E4E7EF;border-radius:12px;overflow:hidden;'><div style='background-color:#373F4B;padding:20px 28px;'><span style='color:#FFFFFF;font-size:18px;font-weight:bold;'>Weekly Session Registration</span></div><div style='padding:28px;color:#28303F;font-size:14px;line-height:1.6;'>@{replace(triggerBody()?['text_2'], decodeUriComponent('%0A'), '<br>')}</div><div style='padding:16px 28px;background-color:#F6F7FB;border-top:1px solid #E4E7EF;color:#68738A;font-size:12px;'>This is an automated message from the Weekly Session Registration app. Please do not reply.</div></div></div>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Respond_to_a_PowerApp_or_flow": {
          "runAfter": {
            "Teams_card_optional": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "result": "ok"
            },
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "title": "result",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        },
        "Post_adaptive_card_in_Teams": {
          "runAfter": {
            "Send_an_email_(V2)": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
              "connectionName": "shared_teams",
              "operationId": "PostCardToConversation"
            },
            "parameters": {
              "poster": "Flow bot",
              "location": "Chat with Flow bot",
              "body/recipient": "@triggerBody()?['text']",
              "body/messageBody": "{\"type\": \"AdaptiveCard\", \"$schema\": \"http://adaptivecards.io/schemas/adaptive-card.json\", \"version\": \"1.4\", \"body\": [{\"type\": \"TextBlock\", \"text\": \"Weekly Session Registration\", \"weight\": \"Bolder\", \"color\": \"Accent\", \"size\": \"Small\"}, {\"type\": \"TextBlock\", \"text\": \"@{replace(triggerBody()?['text_1'], '\\\"', '\\\\\\\"')}\", \"weight\": \"Bolder\", \"size\": \"Medium\", \"wrap\": true}, {\"type\": \"TextBlock\", \"text\": \"@{replace(replace(triggerBody()?['text_2'], '\\\"', '\\\\\\\"'), decodeUriComponent('%0A'), '\\\\n')}\", \"wrap\": true, \"spacing\": \"Medium\"}]}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Teams_card_optional": {
          "runAfter": {
            "Post_adaptive_card_in_Teams": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "type": "Compose",
          "inputs": "Teams card attempted - a failure here (e.g. recipient has no Teams) does not fail the flow"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}