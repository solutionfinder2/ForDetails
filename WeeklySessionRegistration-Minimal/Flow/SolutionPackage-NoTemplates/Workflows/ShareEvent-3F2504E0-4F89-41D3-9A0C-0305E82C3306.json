{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "impersonation": {},
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "wsr_sharedoffice365"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "To",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Recipient email addresses (semicolon-separated)",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "Subject",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Email subject",
                  "x-ms-content-hint": "TEXT"
                },
                "text_2": {
                  "title": "Body",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Email body (plain text)",
                  "x-ms-content-hint": "TEXT"
                },
                "text_3": {
                  "title": "EventName",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Name of the event being shared",
                  "x-ms-content-hint": "TEXT"
                },
                "text_4": {
                  "title": "EventLink",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Deep link to the event detail page in the app",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text",
                "text_1",
                "text_2",
                "text_3",
                "text_4"
              ]
            }
          }
        }
      },
      "actions": {
        "Send_an_email_(V2)": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
            },
            "parameters": {
              "emailMessage/To": "@triggerBody()?['text']",
              "emailMessage/Subject": "@triggerBody()?['text_1']",
              "emailMessage/Body": "<p>@{replace(triggerBody()?['text_2'], decodeUriComponent('%0A'), '<br>')}</p><p><a href=\"@{triggerBody()?['text_4']}\" style=\"display:inline-block;padding:10px 22px;background-color:#373F4B;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;\">Open &quot;@{triggerBody()?['text_3']}&quot; in the app</a></p><p style=\"color:#68738A;font-size:12px;\">If the button doesn't work, copy this link into your browser:<br>@{triggerBody()?['text_4']}</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Respond_to_a_PowerApp_or_flow": {
          "runAfter": {
            "Send_an_email_(V2)": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "result": "ok"
            },
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "title": "result",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
